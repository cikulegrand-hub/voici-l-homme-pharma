{
  "name": "@vhp/backend",
  "version": "1.0.0",
  "private": true,
  "description": "Voici l'Homme Pharma - NestJS API Backend (VHP-CDC-001)",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "db:migrate": "node scripts/migrate.js",
    "seed:admin": "node scripts/create-initial-admin.js",
    "seed:demo": "node scripts/seed-demo-accounts.js",
    "test": "node scripts/create-admin-account.js && node test/e2e/run_all_e2e_with_server.js",
    "test:jest": "jest --config ../../jest.config.js --runInBand",
    "test:rpt": "npm run build && node test/rpt-rec06.test.js",
    "test:e2e": "node test/e2e/run_all_e2e_with_server.js",
    "test:module4": "node scripts/create-admin-account.js && node -e \"process.env.E2E_SUITE='04_stock_and_purchases_module.e2e.js'; require('./test/e2e/run_all_e2e_with_server.js')\""
  },
  "dependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/common": "^10.4.1",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.1",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.1",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^7.4.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@vhp/shared": "*",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.12.0",
    "prisma": "^7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typescript": "^5.5.4"
  },
  "devDependencies": {
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.4",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.11.8",
    "jest": "^29.7.0"
  }
}
