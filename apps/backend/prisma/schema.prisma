generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model audit_logs {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pharmacy_id String     @db.Uuid
  user_id     String?    @db.Uuid
  action      String     @db.VarChar(100)
  entity_name String     @db.VarChar(100)
  entity_id   String     @db.VarChar(100)
  old_values  Json?
  new_values  Json?
  ip_address  String?    @db.VarChar(50)
  user_agent  String?
  created_at  DateTime   @default(now()) @db.Timestamptz(6)
  pharmacies  pharmacies @relation(fields: [pharmacy_id], references: [id], onUpdate: NoAction)
  users       users?     @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([entity_name, entity_id], map: "idx_audit_logs_entity")
  @@index([pharmacy_id, created_at(sort: Desc)], map: "idx_audit_logs_pharmacy_date")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model cash_sessions {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pharmacy_id         String              @db.Uuid
  user_id             String              @unique(map: "uk_single_open_cash_session_per_user", where: raw("(status = 'OUVERTE'::cash_session_status)")) @db.Uuid
  opened_at           DateTime            @default(now()) @db.Timestamptz(6)
  closed_at           DateTime?           @db.Timestamptz(6)
  initial_float_cdf   Decimal             @default(0.00) @db.Decimal(15, 2)
  initial_float_usd   Decimal             @default(0.00) @db.Decimal(15, 2)
  expected_amount_cdf Decimal?            @default(0.00) @db.Decimal(15, 2)
  expected_amount_usd Decimal?            @default(0.00) @db.Decimal(15, 2)
  counted_amount_cdf  Decimal?            @db.Decimal(15, 2)
  counted_amount_usd  Decimal?            @db.Decimal(15, 2)
  variance_cdf        Decimal?            @db.Decimal(15, 2)
  variance_usd        Decimal?            @db.Decimal(15, 2)
  variance_reason     String?
  status              cash_session_status @default(OUVERTE)
  pharmacies          pharmacies          @relation(fields: [pharmacy_id], references: [id], onUpdate: NoAction)
  users               users               @relation(fields: [user_id], references: [id], onUpdate: NoAction)
  customer_payments   customer_payments[]
  expenses            expenses[]
  sales               sales[]

  @@index([user_id, status], map: "idx_cash_sessions_user_status")
}

