# ==============================================================================
# Modèle de Configuration d'Environnement API
# ==============================================================================

PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# Connexion PostgreSQL (Prisma)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.CHANGE_ME:CHANGE_ME@CHANGE_ME:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:CHANGE_ME@CHANGE_ME:5432/postgres?sslmode=require"

# Stockage privé des images
SUPABASE_URL=https://CHANGE_ME.supabase.co
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME
SUPABASE_PRESCRIPTIONS_BUCKET=prescriptions
PRESCRIPTIONS_STORAGE_PATH=.data/prescriptions

# ------------------------------------------------------------------------------
# Authentification & Sécurité JWT
# ------------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_AVEC_UNE_CLE_ALEATOIRE_FORTE_D_AU_MOINS_64_CARACTERES
JWT_REFRESH_SECRET=CHANGE_ME_AVEC_UNE_CLE_ALEATOIRE_FORTE_D_AU_MOINS_64_CARACTERES
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# Sécurité Réseau & CORS
# ------------------------------------------------------------------------------
CORS_ORIGIN="http://localhost:4200,http://127.0.0.1:4200"
ENABLE_SWAGGER=false

# ------------------------------------------------------------------------------
# Configuration Officine par défaut
# ------------------------------------------------------------------------------
DEFAULT_PHARMACY_ID=11111111-1111-1111-1111-111111111111
AUDIT_DEFAULT_PHARMACY_ID=11111111-1111-1111-1111-111111111111
