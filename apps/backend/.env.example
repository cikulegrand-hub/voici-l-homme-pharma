# ==============================================================================
# Voici l'Homme Pharma - Modèle de Configuration d'Environnement (VHP-CDC-001)
# ==============================================================================

PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# Connexion PostgreSQL Supabase (Prisma)
# ------------------------------------------------------------------------------
# DATABASE_URL : Session Pooler (port 5432 ou 6543) utilisé par l'application NestJS
DATABASE_URL="postgresql://postgres.CHANGE_ME:CHANGE_ME@CHANGE_ME:5432/postgres?sslmode=require"

# DIRECT_URL : Connexion directe (port 5432) utilisée par Prisma CLI pour les migrations
DIRECT_URL="postgresql://postgres:CHANGE_ME@CHANGE_ME:5432/postgres?sslmode=require"

# Stockage privé des images d'ordonnance (CLI-06). Le bucket doit rester privé.
SUPABASE_URL=https://CHANGE_ME.supabase.co
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME
SUPABASE_PRESCRIPTIONS_BUCKET=prescriptions
# Fallback local storage (development only). Mount this directory on a persistent volume in production.
PRESCRIPTIONS_STORAGE_PATH=.data/prescriptions

# ------------------------------------------------------------------------------
# Authentification & Sécurité JWT (AUT-01 à AUT-08)
# ------------------------------------------------------------------------------
# OBLIGATOIRE EN PRODUCTION : chaîne cryptographique aléatoire forte (>= 64 caractères)
JWT_SECRET=CHANGE_ME_AVEC_UNE_CLE_ALEATOIRE_FORTE_D_AU_MOINS_64_CARACTERES
JWT_REFRESH_SECRET=CHANGE_ME_AVEC_UNE_CLE_ALEATOIRE_FORTE_D_AU_MOINS_64_CARACTERES
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# Sécurité Réseau & CORS (VHP-SEC-03)
# ------------------------------------------------------------------------------
# Domaines autorisés en production séparés par des virgules (ex: https://app.voicilhomme.cd)
CORS_ORIGIN="http://localhost:4200,http://127.0.0.1:4200"

# Documentation OpenAPI : désactivée par défaut en production (mettre à 'true' si besoin)
ENABLE_SWAGGER=false

# ------------------------------------------------------------------------------
# ID Officine par défaut (Pilote Kinshasa · Limete)
# ------------------------------------------------------------------------------
DEFAULT_PHARMACY_ID=11111111-1111-1111-1111-111111111111
AUDIT_DEFAULT_PHARMACY_ID=11111111-1111-1111-1111-111111111111
