{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@vhp/shared": [
        "packages/shared/src/index.ts"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    "prototype-reference",
    "apps/frontend",
    "apps/backend"
  ]
}